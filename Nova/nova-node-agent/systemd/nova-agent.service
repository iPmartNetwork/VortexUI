[Unit]
Description=Nova VPS node agent (admin panel + xray bridge)
After=network-online.target
Wants=network-online.target
# The proxy itself; the agent manages its config and reads its stats API.
After=xray.service

[Service]
Type=simple
# Adjust WorkingDirectory to where the repo is deployed.
WorkingDirectory=/opt/nova-node-agent
ExecStart=/usr/bin/node /opt/nova-node-agent/bin/nova-agent.mjs
EnvironmentFile=/etc/nova/agent.env
Restart=always
RestartSec=2
# The agent binds 127.0.0.1 only; Cloudflare + xray face the internet on :443.
# It needs to write the xray config and chgrp the origin cert, so it runs as
# root for the MVP. Tighten with CAP_CHOWN + a dedicated user in a later pass.
User=root
NoNewPrivileges=true
ProtectSystem=full
StateDirectory=nova

[Install]
WantedBy=multi-user.target
