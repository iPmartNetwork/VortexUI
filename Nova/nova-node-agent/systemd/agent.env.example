# Copy to /etc/nova/agent.env and edit. Referenced by nova-agent.service.
NOVA_DB=/var/lib/nova/nova.db
NOVA_PORT=8088
NOVA_HOST=127.0.0.1
NOVA_POLL_MS=30000
NOVA_XRAY_API=127.0.0.1:10085
NOVA_XRAY_BIN=/usr/local/bin/xray
NOVA_XRAY_CONFIG=/usr/local/etc/xray/config.json
NOVA_XRAY_SERVICE=xray
NOVA_CERT_PEM=/etc/nova/origin.pem
NOVA_CERT_KEY=/etc/nova/origin.key
NOVA_CERT_GROUP=nogroup
